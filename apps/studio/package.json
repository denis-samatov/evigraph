{
  "name": "evigraph-studio",
  "version": "2.8.0",
  "private": true,
  "homepage": "https://github.com/denis-samatov/evigraph",
  "repository": {
    "type": "git",
    "url": "https://github.com/denis-samatov/evigraph.git"
  },
  "license": "(EPL-2.0 OR GPL-2.0 WITH Classpath-exception-2.0 OR MIT)",
  "author": {
    "name": "EviGraph"
  },
  "workspaces": [
    "evigraph-glsp-client",
    "evigraph-glsp-server",
    "evigraph-theia",
    "evigraph-studio-app"
  ],
  "scripts": {
    "all": "yarn clean && yarn install && yarn lint",
    "browser": "yarn --cwd evigraph-studio-app",
    "build": "yarn compile && yarn bundle",
    "bundle": " yarn server bundle && yarn browser bundle",
    "check:theia-version": "theia check:theia-version",
    "clean": "lerna run clean",
    "compile": "tsc -b",
    "lint": "eslint .",
    "lint:ci": "yarn lint --output-file eslint_report.json --format json",
    "prepare": "yarn build && yarn check:theia-version",
    "server": "yarn --cwd evigraph-glsp-server",
    "server:start": "yarn --cwd evigraph-glsp-server start",
    "start": "yarn browser start",
    "start:external": "yarn browser start:external",
    "watch": "concurrently --kill-others -n tsc,browser,server -c red,yellow \"tsc -b -w --preserveWatchOutput\" \"yarn -s browser watch\" \"yarn -s server watch:bundle\""
  },
  "devDependencies": {
    "@eclipse-glsp/config": "2.8.0",
    "concurrently": "^8.2.2",
    "lerna": "^8.1.7",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=22",
    "yarn": ">=1.7.0 <2.x.x"
  },
  "description": "EviGraph Studio: Theia + GLSP IDE over the EviGraph Core API"
}
